<UserControl x:Class="OpenSteamAnalyzer.Views.DiscountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,22"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Text="Steam 商店折扣" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="当前正在打折的 Steam 商店游戏，按折扣百分比排序" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}"
                           Text="{Binding StatusText}" />
                <Button Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Games}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="52"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#EEF2F7"
                                        CornerRadius="6">
                                    <Image Source="{Binding DisplayImageSource}"
                                           Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Name}" Header="游戏" Width="*" />
                    <DataGridTextColumn Binding="{Binding DiscountText}" Header="折扣" Width="110" />
                    <DataGridTextColumn Binding="{Binding OriginalPrice}" Header="原价" Width="130" />
                    <DataGridTextColumn Binding="{Binding FinalPrice}" Header="现价" Width="130" />
                    <DataGridTemplateColumn Header="商店" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="72"
                                        Height="32"
                                        Padding="0"
                                        Click="OpenStoreButton_OnClick"
                                        Content="打开" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
