                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                <Path Data="M512 360.489796c-83.591837 0-151.510204 67.918367-151.510204 151.510204s67.918367 151.510204 151.510204 151.510204 151.510204-67.918367 151.510204-151.510204-67.918367-151.510204-151.510204-151.510204z m0 261.22449c-60.604082 0-109.714286-49.110204-109.714286-109.714286s49.110204-109.714286 109.714286-109.714286 109.714286 49.110204 109.714286 109.714286-49.110204 109.714286-109.714286 109.714286z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:DashboardView DataContext="{Binding Dashboard}"
                                 Visibility="{Binding DataContext.IsDashboardSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:DiscountsView DataContext="{Binding Discounts}"
                                 Visibility="{Binding DataContext.IsDiscountsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
