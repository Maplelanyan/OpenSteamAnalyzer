<Window x:Class="OpenSteamAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenSteamAnalyzer.ViewModels"
        xmlns:views="clr-namespace:OpenSteamAnalyzer.Views"
        Title="Open Steam Analyzer"
        Height="860"
        MinHeight="760"
        MinWidth="860"
        Width="1280">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="NavIconButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid Width="{TemplateBinding Width}"
                                  Height="{TemplateBinding Height}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EAF2FF" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DDEBFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="Open Steam Analyzer" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource NavIconButtonStyle}"
                            Tag="{Binding IsDashboardSelected}"
                            ToolTip="分析">
                        <Viewbox Width="24" Height="24">
                            <Grid Width="1024" Height="1024">
                                <Path Data="M160 802.1h704c26.5 0 48 21.5 48 48s-21.5 48-48 48H160c-26.5 0-48-21.5-48-48s21.5-48 48-48zM222.4 451.2h96c22.1 0 40 17.9 40 40v230.4h-176V491.2c0-22.1 17.9-40 40-40zM464 285.6h96c22.1 0 40 17.9 40 40v396H424v-396c0-22.1 17.9-40 40-40zM705.6 169.6h96c22.1 0 40 17.9 40 40v512h-176v-512c0-22.1 17.9-40 40-40z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                <Path Data="M240 721.6V520h60.8v201.6H240zM481.6 721.6V354.4h60.8v367.2H481.6zM723.2 721.6V238.4H784v483.2h-60.8z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Margin="0,0,10,0"
                            Command="{Binding ShowDiscountsCommand}"
                            Style="{StaticResource NavIconButtonStyle}"
                            Tag="{Binding IsDiscountsSelected}"
                            ToolTip="折扣">
                        <Viewbox Width="24" Height="24">
                            <Grid Width="1024" Height="1024">
                                <Path Data="M512 112c220.9 0 400 179.1 400 400S732.9 912 512 912 112 732.9 112 512 291.1 112 512 112zM349.7 315.6c-45.3 0-82.1 36.7-82.1 82.1s36.7 82.1 82.1 82.1 82.1-36.7 82.1-82.1-36.8-82.1-82.1-82.1zM695.1 328 328 695.1l45.3 45.3 367.1-367.1L695.1 328zM674.3 544.2c-45.3 0-82.1 36.7-82.1 82.1s36.7 82.1 82.1 82.1 82.1-36.7 82.1-82.1-36.8-82.1-82.1-82.1z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavIconButtonStyle}"
                            Tag="{Binding IsSettingsSelected}"
                            ToolTip="设置">
